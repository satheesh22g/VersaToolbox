{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 8,
  "automergeType": "pr",
  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "allowedVersions": "/^[0-9]+\\.[0-9]+(\\.[0-9]+)?$/"
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchDepTypes": ["dev", "build-system.requires"],
      "automerge": true
    },
    {
      "matchPackageNames": ["*"],
      "matchCurrentVersion":"/^(?![0-9]+\\.[0-9]+(\\.[0-9]+)?$).*/",
      "automerge": false
    }

  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  }
}
